-- HD2-Addon: mods/tylerkilburn/viper_hud
-- Viper HUD for Helldivers 2
-- Tactical combat UI overlay for Managed Democracy
-- Feature 1: Fire Mode Indicator with Autocannon APHET vs FLAK detection

local ViperHUD = {
    version = "1.0.0",
    author = "tylerkilburn",
    enabled = true
}

-- Config
ViperHUD.Config = {
    fire_mode = {
        enabled = true,
        offset_x = -260, -- pixels from screen right
        offset_y = 120,  -- pixels from screen bottom
        font_size = 18,
        color_aphet = { r = 1.0, g = 0.45, b = 0.15, a = 0.95 }, -- Amber/Gold [ APHET ]
        color_flak  = { r = 0.2, g = 0.85, b = 1.0, a = 0.95 },  -- Electric Cyan [ FLAK ]
        color_auto  = { r = 1.0, g = 0.65, b = 0.2, a = 0.9 },   -- Amber [ AUTO ]
        color_burst = { r = 0.35, g = 0.85, b = 1.0, a = 0.9 }, -- Cyan [ BURST ]
        color_semi  = { r = 0.7, g = 0.95, b = 0.7, a = 0.85 },  -- Light Green [ SEMI ]
        bg_color    = { r = 0.05, g = 0.08, b = 0.12, a = 0.7 },
    }
}

-- Engine GUI Context
local cached_gui = nil
local screen_w, screen_h = 1920, 1080

local function get_gui()
    if cached_gui then return cached_gui end
    if rawget(_G, "SimpleGUI") and SimpleGUI.gui then
        cached_gui = SimpleGUI.gui
        return cached_gui
    end
    if rawget(_G, "Gui") and rawget(_G, "Managers") and Managers.world then
        local world = Managers.world:world("top_ingame_view") or Managers.world:world("level_world")
        if world and rawget(_G, "World") then
            cached_gui = World.create_screen_gui(world, "immediate", "material", "core/gui/gui")
        end
    end
    return cached_gui
end

-- Weapon Introspection
local function get_active_weapon_info()
    local success, info = pcall(function()
        if not rawget(_G, "Managers") or not Managers.player then return nil end
        local player = Managers.player:local_player()
        if not player or not player.player_unit then return nil end
        
        local unit = player.player_unit
        if not Unit.alive(unit) then return nil end

        local inventory_ext = Unit.has_extension(unit, "inventory_system") and Unit.extension(unit, "inventory_system")
        if not inventory_ext then return nil end

        local weapon_unit = (inventory_ext.get_weapon_unit and inventory_ext:get_weapon_unit())
                         or (inventory_ext.wielded_unit and inventory_ext:wielded_unit())
        if not weapon_unit or not Unit.alive(weapon_unit) then return nil end

        local weapon_ext = Unit.has_extension(weapon_unit, "weapon_system") and Unit.extension(weapon_unit, "weapon_system")
        local wielded_slot = (inventory_ext.wielded_slot_name and inventory_ext:wielded_slot_name())
        local item_data = wielded_slot and inventory_ext.get_item_data and inventory_ext:get_item_data(wielded_slot)

        local weapon_name = ""
        if item_data and item_data.name then
            weapon_name = tostring(item_data.name)
        elseif weapon_unit and Unit.get_data then
            weapon_name = tostring(Unit.get_data(weapon_unit, "unit_name") or "")
        end

        local name_lower = string.lower(weapon_name)
        local is_autocannon = string.find(name_lower, "autocannon") 
                           or string.find(name_lower, "ac8") 
                           or string.find(name_lower, "ac_8")

        local ammo_mode = nil
        if weapon_ext then
            if weapon_ext.current_ammo_type then
                ammo_mode = weapon_ext:current_ammo_type()
            elseif weapon_ext.ammo_type then
                ammo_mode = weapon_ext.ammo_type
            elseif weapon_ext.selected_projectile_mode then
                ammo_mode = weapon_ext:selected_projectile_mode()
            elseif weapon_ext.current_fire_mode then
                ammo_mode = weapon_ext:current_fire_mode()
            end
        end

        local fire_mode = nil
        if weapon_ext then
            if weapon_ext.current_fire_mode then
                fire_mode = weapon_ext:current_fire_mode()
            elseif weapon_ext.fire_mode then
                fire_mode = weapon_ext.fire_mode
            end
        end

        return {
            weapon_name = weapon_name,
            is_autocannon = is_autocannon,
            ammo_mode = ammo_mode,
            fire_mode = fire_mode,
        }
    end)

    if success and info then
        return info
    end
    return nil
end

local function format_display(info)
    if not info then
        return "[ AUTO ]", "auto", false
    end

    -- Specialized Autocannon Handling: APHET vs FLAK
    if info.is_autocannon then
        local raw_ammo = string.lower(tostring(info.ammo_mode or ""))
        local rate = ""
        if info.fire_mode then
            local r = string.lower(tostring(info.fire_mode))
            if string.find(r, "auto") or string.find(r, "full") then
                rate = "AUTO"
            else
                rate = "SEMI"
            end
        end

        if string.find(raw_ammo, "flak") or string.find(raw_ammo, "airburst") or string.find(raw_ammo, "prox") then
            local label = (rate ~= "") and string.format("[ FLAK | %s ]", rate) or "[ FLAK ]"
            return label, "flak", true
        else
            local label = (rate ~= "") and string.format("[ APHET | %s ]", rate) or "[ APHET ]"
            return label, "aphet", true
        end
    end

    -- Standard Weapons
    local m = string.lower(tostring(info.fire_mode or "auto"))
    if string.find(m, "semi") or string.find(m, "single") or m == "1" then
        return "[ SEMI ]", "semi", false
    elseif string.find(m, "burst") or m == "3" then
        return "[ BURST ]", "burst", false
    else
        return "[ AUTO ]", "auto", false
    end
end

-- Render Frame
function ViperHUD.update(dt)
    if not ViperHUD.enabled then return end

    pcall(function()
        if rawget(_G, "Application") and Application.resolution then
            screen_w, screen_h = Application.resolution()
        end

        local info = get_active_weapon_info()
        local label, mode_type, is_ac = format_display(info)

        local cfg = ViperHUD.Config.fire_mode
        local color = cfg.color_auto
        if mode_type == "aphet" then
            color = cfg.color_aphet
        elseif mode_type == "flak" then
            color = cfg.color_flak
        elseif mode_type == "semi" then
            color = cfg.color_semi
        elseif mode_type == "burst" then
            color = cfg.color_burst
        end

        local pos_x = screen_w + cfg.offset_x
        local pos_y = screen_h - cfg.offset_y

        -- Autocannon label is slightly wider
        local panel_width = is_ac and 125 or 85

        local gui = get_gui()
        if gui and rawget(_G, "Gui") then
            -- Tactical dark pill background
            if Gui.rect and cfg.bg_color then
                local bg = cfg.bg_color
                local bg_c = (rawget(_G, "Color4") and Color4(bg.r, bg.g, bg.b, bg.a)) 
                          or (rawget(_G, "Color") and Color(bg.a * 255, bg.r * 255, bg.g * 255, bg.b * 255))
                if bg_c then
                    Gui.rect(gui, pos_x - 8, pos_y - 4, panel_width, 26, bg_c)
                end
            end

            -- Fire mode text indicator
            if Gui.text then
                local font = "core/fonts/arial"
                local txt_c = (rawget(_G, "Color4") and Color4(color.r, color.g, color.b, color.a)) 
                           or (rawget(_G, "Color") and Color(color.a * 255, color.r * 255, color.g * 255, color.b * 255))
                local pos_vec = (rawget(_G, "Vector3") and Vector3(pos_x, pos_y, 0)) or { pos_x, pos_y, 0 }
                if txt_c and pos_vec then
                    Gui.text(gui, label, font, cfg.font_size, pos_vec, txt_c)
                end
            end
        elseif rawget(_G, "SimpleGUI") and SimpleGUI.text then
            SimpleGUI.text(pos_x, pos_y, label, color)
        end
    end)
end

function ViperHUD.init()
    ViperHUD.enabled = true
end

function ViperHUD.shutdown()
    ViperHUD.enabled = false
end

rawset(_G, "ViperHUD", ViperHUD)

return ViperHUD
